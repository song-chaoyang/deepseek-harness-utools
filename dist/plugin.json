{
  "version": "1.0.8",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "development": {
    "main": "index.html"
  },
  "features": [
    {
      "code": "dsh-main",
      "explain": "DeepSeek Harness — AI Agent 工作台（启动服务器、打开 Web UI）",
      "cmds": ["DeepSeek Harness", "dsh", "DSH", "deepseek harness", "AI Agent"]
    },
    {
      "code": "dsh-webui",
      "explain": "启动 DSH 服务器并直接打开 Web UI（可绑定全局快捷键）",
      "cmds": ["dsh web", "DSH WebUI", "打开 DSH Web UI"]
    },
    {
      "code": "dsh-headless",
      "explain": "DSH Headless 任务：提交文本任务，无头执行 Agent（带任务历史）",
      "cmds": ["dsh headless", "dsh task", "DSH 任务", "DSH Headless"]
    },
    {
      "code": "dsh-sessions",
      "explain": "浏览会话历史（搜索、Fork、取消、截图发送、导出）",
      "cmds": ["dsh sessions", "DSH 会话", "dsh history"]
    },
    {
      "code": "dsh-plugin-mgr",
      "explain": "管理 DSH 插件（安装/卸载/搜索）",
      "cmds": ["dsh plugins", "DSH 插件管理", "dsh plugin"]
    },
    {
      "code": "dsh-workspace",
      "explain": "选择工作区目录并在 DSH 中打开",
      "cmds": [
        "dsh workspace",
        "DSH 工作区",
        {
          "type": "files",
          "label": "用 DSH 打开此目录",
          "fileType": "directory",
          "minLength": 1,
          "maxLength": 5
        }
      ],
      "platform": ["win32", "darwin", "linux"]
    },
    {
      "code": "dsh-goals",
      "explain": "管理会话目标（创建/编辑/暂停/恢复/完成）",
      "cmds": ["dsh goals", "DSH 目标", "dsh goal"]
    },
    {
      "code": "dsh-quick-task",
      "explain": "把任意选中文本交给 DSH AI 处理（分析、翻译、重构、解释…）",
      "cmds": [
        "dsh 处理",
        {
          "type": "over",
          "label": "发给 DSH 处理",
          "minLength": 2,
          "maxLength": 8000
        }
      ]
    },
    {
      "code": "dsh-file-task",
      "explain": "把文件交给 DSH AI 分析（代码审查、内容解读、批量处理）",
      "cmds": [
        {
          "type": "files",
          "label": "让 DSH 分析此文件",
          "fileType": "file",
          "minLength": 1,
          "maxLength": 10
        }
      ]
    }
  ],
  "tools": {
    "dsh_run_headless": {
      "description": "使用 DeepSeek Harness 执行一个 AI 编程任务",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "任务描述，例如：分析项目架构"
          },
          "workspace": {
            "type": "string",
            "description": "工作区路径（可选，默认使用当前工作区）"
          }
        },
        "required": ["task"]
      }
    },
    "dsh_list_sessions": {
      "description": "列出所有 DSH 会话历史",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索关键词（可选）"
          }
        }
      }
    },
    "dsh_read_file": {
      "description": "读取指定路径的文件内容",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文件绝对路径"
          }
        },
        "required": ["path"]
      }
    },
    "dsh_search_sessions": {
      "description": "在 DSH 会话历史中搜索内容",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索词"
          }
        },
        "required": ["query"]
      }
    },
    "dsh_get_server_status": {
      "description": "获取 DSH 服务器运行状态",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "dsh_stop_server": {
      "description": "停止 DSH 服务器",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "dsh_restart_server": {
      "description": "重启 DSH 服务器（保持当前工作区/端口/Profile；未运行时直接启动）",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "dsh_create_session": {
      "description": "创建一个新的 DSH 会话",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "string",
            "description": "工作区路径（可选，默认当前工作区）"
          },
          "model": {
            "type": "string",
            "description": "模型（可选）"
          }
        }
      }
    },
    "dsh_send_message": {
      "description": "向 DSH 会话发送消息，让 Agent 处理",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID（可通过 dsh_list_sessions 获取）"
          },
          "message": {
            "type": "string",
            "description": "消息内容"
          }
        },
        "required": ["sessionId", "message"]
      }
    },
    "dsh_update_dsh": {
      "description": "安装/更新 DSH 核心（首次安装可能需几分钟，完成后重启服务器生效）",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
